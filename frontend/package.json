{
  "name": "automint-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "analyze": "ANALYZE=true next build",
    "lhci": "lhci autorun",
    "check-bundle-size": "node scripts/check-bundle-size.js",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\""
  },
  "dependencies": {
    "@sentry/nextjs": "10.71.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.0.1",
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "babel-jest": "^30.5.0",
    "eslint": "^10.9.1",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "10.1.8",
    "jest": "^30.5.0",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.0",
    "postcss": "^8.4.40",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "undici": "^8.10.0"
